# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Secrets
.env
.env.local
*.key

# Internal scratch/build directory (drafts, raw scrapes, meta.json, rendered
# intermediates). The final output layout lives in Posts/<category>/ and IS
# tracked; everything under work/ is regenerable and ignored.
work/

# Old Posts/ scratch paths (legacy gitignore entries, kept for safety during
# the work/ transition in case someone's local checkout still has them)
Posts/*/pdfs/*.pdf
Posts/pdfs/*.pdf
Posts/raw/*.json
Posts/.seen_*.json

# Grounded drafter "needs research" signals (operational state, not source)
Posts/.needs_research/

# Dev harness outputs
/tmp/contentprinter_dev/

# OS cruft
.DS_Store
Thumbs.db
